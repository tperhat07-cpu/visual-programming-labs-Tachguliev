    {
        "id": "d7f85ddac52d2be0",
        "type": "function",
        "z": "882724fcf6f40ec6",
        "name": "function 1",
        "func": "const maxCount = msg.payload;\nlet resultsArray = [];\n\nfor (let i = 1; i <= maxCount; i++) {\n    if (i % 2 === 0) {\n        resultsArray.push(i + \" - четное\");\n    } else {\n        resultsArray.push(i + \" - нечетное\");\n    }\n}\n\nconst finalObject = {\n    author: \"Tachguliev\",\n    numbers: resultsArray\n};\n\nmsg.payload = finalObject;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
